# Environment variables for Flight Cancellation Predictor
# Copy this file to .env and update with your values

# Application settings
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Data paths
DATA_DIR=data
MODEL_DIR=models
LOG_DIR=logs

# Model configuration
MODEL_NAME=TabPFNMix
EVAL_METRIC=roc_auc
CUSTOM_THRESHOLD=0.02

# Resource limits
MAX_MEMORY_RATIO=5
MAX_RUNTIME_SECONDS=3600

# API settings (if using API server)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# External services (optional)
# MLFLOW_TRACKING_URI=http://localhost:5000
# WANDB_API_KEY=your_api_key_here
# WANDB_PROJECT=flight-cancellation

# AWS S3 (for remote model storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=your-model-bucket

# Database (if using)
# DATABASE_URL=postgresql://user:password@localhost/dbname